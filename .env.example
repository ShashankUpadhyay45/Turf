# Turf Booking Platform Environment Configuration
# Copy this file to .env or .env.local to configure your local environment

# Google Maps API Key for interactive map views and geocoding
# Leave blank to use direct URL direction fallbacks
VITE_GOOGLE_MAPS_API_KEY=

# Backend REST / GraphQL API base URL (when migrating from local storage mock services)
VITE_API_BASE_URL=https://api.playo.example.com/v1

# Environment mode
VITE_APP_ENV=development
