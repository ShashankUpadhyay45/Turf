# ==============================================================================
# PLAYO TURF BOOKING PLATFORM — BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env to configure your local development or production backend.
# Never commit actual API keys or secrets to version control.

# Server Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Example local: mongodb://localhost:27017/playo_turf
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/playo_turf?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/playo_turf

# JWT Authentication Secret & Token Expiry
JWT_SECRET=playo_super_secure_jwt_secret_production_2026_change_in_prod
JWT_EXPIRES_IN=7d

# Frontend Application Origin (CORS)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ==============================================================================
# AUTOMATIC EMAIL NOTIFICATION PROVIDER
# ==============================================================================
# Supported options: 'resend' | 'sendgrid' | 'smtp' | 'mock'
EMAIL_PROVIDER=mock
EMAIL_FROM="Playo Matches" <bookings@playo.example.com>
EMAIL_API_KEY=

# SMTP Credentials (Required only if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ==============================================================================
# AUTOMATIC WHATSAPP BUSINESS NOTIFICATION PROVIDER
# ==============================================================================
# Supported options: 'meta' | 'twilio' | 'mock'
WHATSAPP_PROVIDER=mock

# Meta WhatsApp Cloud API v18.0 (Required only if WHATSAPP_PROVIDER=meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Twilio WhatsApp API (Required only if WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ==============================================================================
# GOOGLE MAPS API (DIRECTIONS & GEOCODING)
# ==============================================================================
# Optional: If omitted, direct turn-by-turn driving directions URL fallback is used
GOOGLE_MAPS_API_KEY=
